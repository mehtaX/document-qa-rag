# LLM — use groq for cloud deployment, ollama for local
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.1-8b-instant

# Embeddings (runs locally — needs ~2GB RAM on server)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
BM25_K=10
VECTOR_K=10
UPLOADS_PATH=uploads
VECTOR_STORE_PATH=faiss_store
